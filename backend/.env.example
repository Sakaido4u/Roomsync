# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file - it holds passwords.

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:your-postgres-password@localhost:5432/roomsync

# Separate database for the automated tests (pytest). It gets wiped on
# every test run, so it must NOT be the same as DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://postgres:your-postgres-password@localhost:5432/roomsync_test

# Secret used to sign login tokens: at least 32 random characters.
# Generate one in PowerShell (venv active) and paste it here:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Key the camera program sends in the X-Device-Key header: at least 16
# random characters. Generate one the same way as JWT_SECRET:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Give the same key to whoever runs the camera program.
DEVICE_KEY=change-me-camera-key

# Email for notifications and setup codes (fill in later)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# No-show check, in minutes (defaults shown). For a live demo, shorten them,
# e.g. NO_SHOW_REMINDER_AFTER=2 and NO_SHOW_RELEASE_AFTER=1, then restart.
NO_SHOW_REMINDER_AFTER=15
NO_SHOW_RELEASE_AFTER=10
# A camera reading older than this many seconds counts as "No camera data".
OCCUPANCY_STALE_SECONDS=60
